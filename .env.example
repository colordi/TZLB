APP_ENV=development
DATABASE_URL="postgresql://yandi@localhost:5432/forestry_survey"
AUTH_SECRET_KEY=tzlb-dev-secret-change-me
AUTH_COOKIE_NAME=tzlb_session
AUTH_COOKIE_SECURE=false
AUTH_BYPASS_LOCALHOST=false
AUTH_SESSION_TTL_HOURS=12
AUTH_REMEMBER_TTL_DAYS=30
AUTH_DEFAULT_ADMIN_USERNAME=admin
AUTH_DEFAULT_ADMIN_PASSWORD=Forestry@2026
AUTH_DEFAULT_ADMIN_DISPLAY_NAME=系统管理员
WORKORDER_DEFAULT_OUTPUT_FORMAT=doc
WORKORDER_IMAGE_MAX_BYTES=8388608
WORKORDER_IMAGE_MAX_TOTAL_BYTES=25165824
WORKORDER_IMAGE_MAX_DIMENSION=1600
WORKORDER_BATCH_MAX_RECORDS=50
# 素材存储：local（本机磁盘，默认）或 r2（Cloudflare R2，S3 兼容）
ASSET_STORAGE_BACKEND=local
# ASSET_STORAGE_BACKEND=r2 时必填以下四项
# R2_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# 对象 key 前缀，便于一个桶隔离多套环境
# R2_PREFIX=assets/
LOG_LEVEL=INFO
